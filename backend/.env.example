DATABASE_URL=postgresql://user:password@localhost:5432/evazmelk
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://evazmelk.ir,https://www.evazmelk.ir,https://admin.evazmelk.ir
# Choose s3 for Arvan; MEDIA_DIR is only needed for local persistent disk mode.
MEDIA_STORAGE=s3
S3_ENDPOINT_URL=https://s3.ir-central1.arvanstorage.ir
S3_BUCKET=evazmelk-media
S3_ACCESS_KEY_ID=replace-in-liara-only
S3_SECRET_ACCESS_KEY=replace-in-liara-only
# Optional signing region; default us-east-1.
# S3_REGION=us-east-1
# MEDIA_DIR=/var/data/evaz-media
PUBLIC_MEDIA_BASE_URL=https://api.evazmelk.ir/api/public/media
BACKUP_DIR=/var/data/evaz-backups

# SMS.ir verification template; keep these in the backend environment only.
SMS_PROVIDER=smsir
SMSIR_API_KEY=replace-in-liara-only
SMSIR_TEMPLATE_ID=replace-with-approved-template-id
# The approved template uses the parameter CODE (see app/sms_gateway.py).
# Use SMS_PROVIDER=generic only with your own compatible gateway:
# SMS_GATEWAY_URL=https://your-gateway.example/send
# SMS_GATEWAY_TOKEN=replace-in-liara-only
# SMS_SENDER=your-approved-line
